# RedVital · ambiente de producción. Copiar a ambientes/produccion.env.
AMBIENTE=produccion
# Ambiente de ASP.NET Core de Identidad y Campañas (QA | Production).
ASPNETCORE_AMBIENTE=Production
# Hasta que exista un registro de imágenes, cada VM construye desde los repos hermanos.
VERSION=1.0.0

IP_VM_DATOS=10.30.1.10
IP_VM_SERVICIOS=10.30.1.20
IP_VM_BORDE=10.30.1.30
IP_VM_TOOLS=10.20.0.40

DOMINIO=redvital.example.gov.co
IP_PUBLICA_BORDE=0.0.0.0
# Correo de la cuenta ACME si el dominio es público; "internal" si se usa la CA interna.
TLS_MODO=operaciones@example.gov.co

# Raíz de los repos hermanos (contextos de build, migraciones, config de APISIX).
REPOS=../..

SECRETOS_DIR=../secretos/produccion

DB_SSL_JDBC=sslmode=verify-ca&sslrootcert=/run/secrets/postgres_ca
DB_SSL_NPGSQL=SSL Mode=VerifyCA;Root Certificate=/run/secrets/postgres_ca;GSS Encryption Mode=Disable

# Solo métricas: en producción nunca hay semillas.
COMPOSE_PROFILES=metricas
