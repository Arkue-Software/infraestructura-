# RedVital · ambiente QA. Copiar a ambientes/qa.env y ajustar las IP.
# Lo leen los cuatro compose (--env-file) y los scripts. No contiene secretos:
# esos viven como archivos en SECRETOS_DIR, fuera del repositorio.

AMBIENTE=qa
# Ambiente de ASP.NET Core de Identidad y Campañas (QA | Production).
ASPNETCORE_AMBIENTE=QA
# Hasta que exista un registro de imágenes, cada VM construye desde los repos hermanos.
VERSION=qa

# Una IP por VM del ambiente. La VM de Tools es compartida con producción.
IP_VM_DATOS=10.20.1.10
IP_VM_SERVICIOS=10.20.1.20
IP_VM_BORDE=10.20.1.30
IP_VM_TOOLS=10.20.0.40

# Nombre con el que el público llega al borde (dominio o IP).
DOMINIO=qa.redvital.local
# Interfaz donde el borde publica 80/443 (0.0.0.0 = todas).
IP_PUBLICA_BORDE=0.0.0.0
# internal: CA local de Caddy (distribuir su raíz). En producción con dominio
# público: el correo de la cuenta ACME.
TLS_MODO=internal

# Directorio de secretos de este ambiente (ruta absoluta o relativa al compose).
# Raíz de los repos hermanos (contextos de build, migraciones, config de APISIX).
REPOS=../..

SECRETOS_DIR=../secretos/qa

# Postgres con TLS: el servicio verifica la CA del ambiente.
DB_SSL_JDBC=sslmode=verify-ca&sslrootcert=/run/secrets/postgres_ca
DB_SSL_NPGSQL=SSL Mode=VerifyCA;Root Certificate=/run/secrets/postgres_ca;GSS Encryption Mode=Disable

# Perfiles: "semillas" (cuentas U3–U7, campañas y umbrales sintéticos; nunca en
# producción) y "metricas" (node-exporter y cAdvisor para la VM de Tools).
COMPOSE_PROFILES=semillas,metricas
