# RedVital — broker único en KRaft, que actúa a la vez como broker y controlador
# (Herramientas V4.0, entrada 85). Las variables ${...} las resuelve arrancar.sh.

process.roles=broker,controller
node.id=1
controller.quorum.voters=1@localhost:9093
controller.listener.names=CONTROLLER

# INTERNO: red de la VM de servicios (los servicios). EXTERNO: publicado solo
# hacia la VM de Tools (Kafbat). CONTROLLER: solo dentro del contenedor.
listeners=INTERNO://0.0.0.0:9092,EXTERNO://0.0.0.0:9094,CONTROLLER://127.0.0.1:9093
advertised.listeners=INTERNO://${KAFKA_HOST_INTERNO}:9092,EXTERNO://${KAFKA_HOST_EXTERNO}:${KAFKA_PUERTO_EXTERNO}
listener.security.protocol.map=CONTROLLER:PLAINTEXT,INTERNO:SASL_PLAINTEXT,EXTERNO:${KAFKA_PROTOCOLO_EXTERNO}
inter.broker.listener.name=INTERNO

# Autenticación: un usuario SCRAM-SHA-512 por servicio.
sasl.enabled.mechanisms=SCRAM-SHA-512
sasl.mechanism.inter.broker.protocol=SCRAM-SHA-512
listener.name.interno.scram-sha-512.sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required username="inicializacion" password="${KAFKA_CLAVE_ADMIN}";
listener.name.externo.scram-sha-512.sasl.jaas.config=org.apache.kafka.common.security.scram.ScramLoginModule required;
${KAFKA_TLS_EXTERNO}

# Autorización: nada se permite sin ACL. El controlador escucha solo en el
# lazo local del contenedor, por eso su principal anónimo es superusuario.
authorizer.class.name=org.apache.kafka.metadata.authorizer.StandardAuthorizer
super.users=User:inicializacion;User:ANONYMOUS
allow.everyone.if.no.acl.found=false

# Temas: nunca automáticos. Un broker: réplica 1.
auto.create.topics.enable=false
num.partitions=3
default.replication.factor=1
min.insync.replicas=1
offsets.topic.replication.factor=1
transaction.state.log.replication.factor=1
transaction.state.log.min.isr=1
share.coordinator.state.topic.replication.factor=1
share.coordinator.state.topic.min.isr=1

# Retención de 7 días; posiciones de grupo 14 días (DD, sección 14).
log.retention.hours=168
offsets.retention.minutes=20160
log.dirs=/var/lib/kafka/datos
group.initial.rebalance.delay.ms=0
